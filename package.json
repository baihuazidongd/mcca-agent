{
  "name": "mcca-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Run DeepSeek Harness (dsh), pi and the terminal CLIs side by side on one plugin library, one MCP registry and one skills directory, without modifying either runtime.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "pnpm run build && node scripts/bootstrap.mjs",
    "start": "node scripts/start.mjs",
    "portal": "node packages/portal/server.cjs",
    "pi-web": "node packages/pi-web/server.cjs",
    "build": "pnpm --filter @mcca/plugin-sdk build && pnpm --filter @mcca/plugin-host build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:pi-web": "node --test \"packages/pi-web/test/**/*.test.cjs\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@mcca/dsh-adapter": "workspace:^",
    "@mcca/pi-adapter": "workspace:^",
    "@mcca/pi-mcp": "workspace:^",
    "@mcca/plugin-host": "workspace:^",
    "typescript": "^5.9.0"
  }
}
