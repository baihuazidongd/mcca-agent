# ── Dependencies & build output ─────────────────────────────────
node_modules/
dist/
# The Tauri config declares desktop/dist as its frontendDist, so this one dist/
# is a committed asset rather than build output.
!desktop/dist/
*.tsbuildinfo
*.log
.DS_Store

# ── Generated configuration ─────────────────────────────────────
# These name the checkout by absolute path, so they are materialised from the
# committed templates by `pnpm run setup` instead of being committed.
#   config/*.example.json      -> config/mcp.json, config/hot-plugins.json
#   dsh/profiles/web/*         -> config/dsh-home/profiles/web/*
#   config/mcp.json            -> config/dsh-mcp.patch.yml
config/mcp.json
config/hot-plugins.json
config/dsh-mcp.patch.yml
config/dsh-home/
# Backups taken before rewriting a generated config.
config/*.before-*

# ── Runtime state (written by the app, never published) ─────────
# pi agent credentials/settings copy
config/.pi-agent/
# mobile bridge pairing config: holds the phone access token
config/mobile.json
config/mobile-relay.json
# portal event board archive (runtime log, grows over time)
config/portal-events.jsonl
# which IDE / extension instances the user has removed from the portal list
config/portal-instances.json
# portal diary written from the manage page
config/portal-diary.json
# the portal's own event board / memory switch / CLI provider choice
config/portal-agenda.json
config/memory.json
config/cli-providers.json
# per-web-shell session transcripts and window state. The pi-web transcripts in
# particular carry API keys pasted into chat, and the mini-web state remembers
# probed workspaces as absolute paths that name the local user.
config/.pi-web/
config/.pi-web-verify/
config/.pi-web-*/
config/.codex-web/
config/.grok-web/
config/.openhands-web/
config/.mini-web/
config/workbench/
config/runtimes/
# zhipin-guard scan history / zhipin-mcp browser profile (cookies, DBs)
config/zhipin-guard/
config/zhipin-mcp/
# OpenHands/pi conversation event logs written under the app's own workspace
# dir: verbatim chat, plus a base_state holding the live provider config.
workspace/conversations/
workspace/hermes/

# ── Vendored upstream runtime ───────────────────────────────────
# Copy of the dsh upstream repo, synced per README ("上游 dsh 更新后需重新同步").
# Not published: third-party code + build output (~1.9 GB).
vendor/dsh/
# Bundled CLIs (Grok Build, OpenHands). Copied into the app; not a pointer at
# another install.
vendor/cli/
# Third-party Hermes Workspace UI — the chat surface the Hermes tab embeds.
# Clone + node_modules + build output, not published.
vendor/hermes-workspace/

# ── Shared library ──────────────────────────────────────────────
# Local plugins, MCP servers and skills a user grows over time carry machine-
# and account-specific content, so they stay out of the tree. The committed
# samples below are the exception.
plugins/*
mcp/*
skills/*
!plugins/hello-tool/
!mcp/everything/
!skills/hello-skill/
archive/2026-08-27-dsh-plugins/

# ── Agent/browser scratch ───────────────────────────────────────
.playwright-mcp/

# ── Tauri ───────────────────────────────────────────────────────
desktop/src-tauri/target/
desktop/src-tauri/gen/

# ── Android (mobile-app) ────────────────────────────────────────
packages/mobile-app/.gradle/
packages/mobile-app/build/
packages/mobile-app/app/build/
packages/mobile-app/local.properties
packages/mobile-app/.kotlin/

# ── Local debug scratch & captures (not project code) ───────────
# One-off scripts that name the author's own model provider and its relay.
packages/pi-web/test/apply-fix.cjs
packages/pi-web/test/apply-octopath.cjs
packages/pi-web/test/fixer*.cjs
packages/pi-web/test/inspect1.cjs
# Dumps this machine's ~/.pi/agent/models.json into config/. Scratch.
packages/pi-web/test/dump-models.cjs
# UI captures written by screenshot-layout.cjs — scratch, not fixtures.
packages/pi-web/test/*.png
# Point at a private local art workspace and its asset tree.
packages/pi-web/test/list-assets.cjs
packages/pi-web/test/pick-avatars.cjs
# Reads a named pi-web session transcript and writes a personal chat export.
extract_chat.py

# ── Archived app data ───────────────────────────────────────────
# Session transcripts + settings under config/.pi-agent: carries the local
# user name in logged paths. The source snapshot next to it is published.
archive/pi-dsh-web-data-*.tar.gz

# ── Tests whose subject is unpublished ──────────────────────────
# These import from the plugins/ and mcp/ trees excluded above, so they
# cannot run in a clone of this repository.
test/zhipin-guard.test.mjs
test/zhipin-mcp.test.mjs
scripts/smoke-zhipin-mcp.mjs

# ── Release artifacts ───────────────────────────────────────────
# Built by `pnpm run pack` (or by hand); local artifacts.
dist-release/

# ── Stray junk ──────────────────────────────────────────────────
# Windows cache DBs written by an unexpanded %SystemDrive% variable.
%SystemDrive%/
